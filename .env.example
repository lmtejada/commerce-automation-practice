# Copy to .env and adjust. .env is git-ignored; every variable is validated in src/config.ts.

# Runtime environment: development | test | production. Optional, defaults to development.
NODE_ENV=development

# Minimum log level: debug | info | warn | error. Optional, defaults to info.
LOG_LEVEL=info

# Human-readable app name shown in logs. Required.
APP_NAME=commerce-automation-practice

# Google Gemini API key used by the agent (https://aistudio.google.com/apikey). Required.
GOOGLE_GENERATIVE_AI_API_KEY=your-api-key
